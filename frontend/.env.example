# =====================================================================
# PROOFLEARN Frontend Environment Variables Template
# =====================================================================
# Copy this file to .env.local for local development.
# CAUTION: Never commit actual secret keys into version control.

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & PostgreSQL Configuration (Public Safe Credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder

# NOTE: Private secrets (e.g. Google OAuth Client Secret, Supabase Service Role Key)
# must NEVER be placed in frontend configuration or NEXT_PUBLIC_* variables.
