# =====================================================================
# PROOFLEARN FastAPI Backend Environment Variables Template
# =====================================================================
# Copy this file to .env for local development.
# CAUTION: Never commit actual secret keys or credentials to Git.

# Application Configuration
APP_NAME=PROOFLEARN API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Security & Invariants
PROOF_MODE_STRICT_LOCKDOWN=true
