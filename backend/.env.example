# =====================================================================
# PROOFLEARN Backend Environment Variables Template
# =====================================================================
# Copy this file to .env for local development.
# CAUTION: Never commit actual secret keys or API credentials into Git.

# Application Configuration
APP_NAME=PROOFLEARN API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# CORS Origins (Frontend Client URLs)
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL & Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Google Gemini AI Configuration (Backend Only - Never expose to Frontend)
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_HISTORY_MESSAGES=10

# Security & Verification Mode Lockdown
PROOF_MODE_STRICT_LOCKDOWN=true
